<VirtualHost    *:80>
    ServerAdmin        dan@langille.org
    ServerName         FreshSource.org

    Redirect permanent / http://www.FreshSource.org/

    ErrorLog           /var/log/freshsource.org-error.log
    CustomLog          /var/log/freshsource.org-access.log combined
</VirtualHost>

<VirtualHost    *:80>
    ServerAdmin        dan@langille.org
    DocumentRoot       /var/logfreshsource.org/www
    ServerName         www.FreshSource.org
    ServerAlias        FreshSource.org

    ErrorLog           /var/log/freshsource.org-error.log
    CustomLog          /var/log/freshsource.org-access.log combined

    Alias              /icons/ "/usr/local/share/apache/icons/"

</VirtualHost>


<VirtualHost *:443>
    ServerAdmin     dan@langille.org
    ServerName      freshsource.org

    Redirect        permanent / https://www.freshsource.org/

    ErrorLog        /var/log/freshsource.org-error.log
    CustomLog       /var/log/freshsource.org-access.log combined

    SSLEngine on
    SSLCipherSuite ALL:!ADH:!EXPORT56:RC4+RSA:+HIGH:+MEDIUM:+LOW:-SSLv2:+EXP:+eNULL

    SSLCertificateFile    /usr/local/etc/ssl/www.freshsource.org.fullchain.cer
    SSLCertificateKeyFile /usr/local/etc/ssl/www.freshsource.org.key

    SSLCACertificateFile    /usr/local/etc/ssl/ca.pem
</VirtualHost>

<VirtualHost *:443>
    ServerAdmin     dan@langille.org
    ServerName      www.freshsource.org

    Redirect        permanent / https://www.freshsource.org/

    ErrorLog        /var/log/freshsource.org-error.log
    CustomLog       /var/log/freshsource.org-access.log combined

    SSLEngine on
    SSLCipherSuite ALL:!ADH:!EXPORT56:RC4+RSA:+HIGH:+MEDIUM:+LOW:-SSLv2:+EXP:+eNULL

    SSLCertificateFile    /usr/local/etc/ssl/www.freshsource.org.fullchain.cer
    SSLCertificateKeyFile /usr/local/etc/ssl/www.freshsource.org.key

    SSLCACertificateFile    /usr/local/etc/ssl/ca.pem
</VirtualHost>
