server {
  listen 10.55.0.47:80;

  include "/usr/local/etc/freshsource/virtualhost-common.conf";

  return 301 https://$server_name$request_uri;
}

server {
  listen 10.55.0.47:443 ssl;
  http2 on;
  
  include "/usr/local/etc/freshsource/virtualhost-common.conf";
  include "/usr/local/etc/freshsource/virtualhost-common-ssl.conf";

  ssl_certificate     /usr/local/etc/ssl/devgit.freshsource.org.fullchain.cer;
  ssl_certificate_key /usr/local/etc/ssl/devgit.freshsource.org.key;
}
