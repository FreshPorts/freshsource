function UserToCookie($User) {
	$EncodedUserID = base64_encode(strtolower($User));
	$EncodedUserID = base64_encode($EncodedUserID);
	$EncodedUserID = base64_encode($EncodedUserID);
	$EncodedUserID = base64_encode($EncodedUserID);
	$EncodedUserID = base64_encode($EncodedUserID);
	$EncodedUserID = urlencode($EncodedUserID);

	return $EncodedUserID;
}

