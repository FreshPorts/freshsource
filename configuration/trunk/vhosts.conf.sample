<VirtualHost    *>
	ServerAdmin		dan@langille.org
	ServerName		FreshSource.org

	Redirect permanent / http://www.FreshSource.org/

	ErrorLog		/usr/websites/log/freshsource.org-error.log
	CustomLog		/usr/websites/log/freshsource.org-access.log combined
</VirtualHost>

<VirtualHost	*>
	ServerAdmin		dan@langille.org
	DocumentRoot	/usr/websites/freshsource.org/www
	ServerName		www.FreshSource.org
	ServerAlias		FreshSource.org

	ErrorLog		/usr/websites/log/freshsource.org-error.log
	CustomLog		/usr/websites/log/freshsource.org-access.log combined

	Alias		/icons/		"/usr/local/share/apache/icons/"

</VirtualHost>
